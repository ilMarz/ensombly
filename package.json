{
  "name": "ensombly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "supabase db push",
    "db:push:prod": "dotenv -e .env -- node scripts/migrate.mjs",
    "db:push:test": "dotenv -e .env.test -- node scripts/migrate.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "seed:admin": "dotenv -e .env -- tsx scripts/seed-admin.ts",
    "seed:admin:test": "dotenv -e .env.test -- tsx scripts/seed-admin.ts",
    "seed:users": "dotenv -e .env -- tsx scripts/seed-users.ts",
    "seed:projects": "dotenv -e .env -- tsx scripts/seed-projects.ts"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@flags-sdk/vercel": "^1.4.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flags": "^4.1.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
